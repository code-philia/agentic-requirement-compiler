            }
          },
          "required": [
            "kind",
            "ui_id",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "UI_REF"
            },
            "ui_id": {
              "type": "string",
              "pattern": "^[U]\\.[A-Za-z0-9_][A-Za-z0-9_.-]*$"
            }
          },
          "required": [
            "kind",
            "ui_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "OP"
            },
            "operator": {
              "enum": [
                "NOT",
                "LENGTH",
                "IF",
                "AND",
                "OR",
                "EQ",
                "NE",
                "GT",
                "GE",
                "LT",
                "LE",
                "ADD",
                "SUB",
                "MUL",
                "DIV",
                "CONCAT",
                "COALESCE"
