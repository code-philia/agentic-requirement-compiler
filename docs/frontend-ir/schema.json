              "children": {
                "maxItems": 0
              },
              "text": {
                "$ref": "#/$defs/expression"
              },
              "component_ref": {
                "type": "null"
              },
              "arguments": {
                "maxItems": 0
              },
              "callbacks": {
                "maxItems": 0
              },
              "slot_data_id": {
                "type": "null"
              }
            }
          }
        },
        {
