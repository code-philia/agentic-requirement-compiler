# ============================================================
# ARC Configuration Example
# ============================================================
# Copy this file to .env and fill in your values.
# Configuration priority: shell env > ARC_ENV_FILE > ./.env

# ============================================================
# Required: OpenAI Chat Completions API endpoint
# ============================================================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Required: Main coding model
# Examples: gpt-4o, gpt-4-turbo, claude-3-5-sonnet (via compatible endpoint)
MODEL=gpt-4o

# ============================================================
# Optional: Visual analysis for screenshots and UI references
# ============================================================
# Leave empty to skip visual analysis or reuse main model settings
VISUAL_API_KEY=
VISUAL_BASE_URL=
VISUAL_MODEL=

# ARC_VISUAL_TIMEOUT_SECONDS: timeout for one multimodal reference-analysis request
# Default: 120
ARC_VISUAL_TIMEOUT_SECONDS=120

# ============================================================
# Optional: Compiler tuning
# ============================================================
# ARC_WEB_PORT: generated backend, frontend API target, and Playwright base port.
# It is used when `arc compile --port` is not supplied.
# Default: 3000
ARC_WEB_PORT=3000

# ARC_STRUCTURED_OUTPUT_RETRY_COUNT: Retry budget when agent output parsing fails
# Default: 2
ARC_STRUCTURED_OUTPUT_RETRY_COUNT=2

# ARC_MODEL_TRANSPORT_RETRIES: OpenAI-compatible client retries for transient transport failures
# Default: 3. Agent-level retries additionally back off for 2s, 8s, then 30s.
ARC_MODEL_TRANSPORT_RETRIES=3

# ARC_DISABLE_THINKING: when enabled, request reasoning_effort=none and
# extra_body.thinking.type=disabled for every model call.
ARC_DISABLE_THINKING=0

# ARC_COST_STACK: append cumulative model cost accounting and create ZIP snapshots
# at each ARC_COST_SNAPSHOT_STEP currency units (disabled by default).
ARC_COST_STACK=0
ARC_COST_SNAPSHOT_STEP=10

# ARC_DATABASE_TRACE: Print Stage 1 pass progress and rejected decision summaries
# Default: 1
ARC_DATABASE_TRACE=1

# ARC_DESIGN_MAX_MODULES_PER_REQUIREMENT: Safety cap for one requirement's materialized modules
# Default: 64 (accepted range: 4-256)
ARC_DESIGN_MAX_MODULES_PER_REQUIREMENT=64

# ARC_DESIGN_REOPEN_COUNT: Parent decomposition / API regeneration budget
# Default: 2 (accepted range: 0-6)
ARC_DESIGN_REOPEN_COUNT=2

# ARC_DESIGN_TRACE: Print every Stage 2 model input/output and validation event to terminal and debug.log
# Default: 1
ARC_DESIGN_TRACE=1

# ARC_FRONTEND_DESIGN_TRACE: Print all Frontend Design model input/output and validation events
# Includes safe visual metadata, UI Scope, Component, and Contract/Binding calls
# Default: 1
ARC_FRONTEND_DESIGN_TRACE=1

# ARC_TDD_MAX_ITERATIONS_PER_NODE: Functional implementation budget per atomic requirement
# Default: 8
ARC_TDD_MAX_ITERATIONS_PER_NODE=3

# ARC_TDD_NO_PROGRESS_LIMIT: Stop after this many unchanged failure fingerprints
# Default: 2
ARC_TDD_NO_PROGRESS_LIMIT=3

# ARC_TDD_INFRA_RETRY_COUNT: Infrastructure retries that do not consume implementation budget
# Default: 2
ARC_TDD_INFRA_RETRY_COUNT=2

# ARC_TDD_TYPECHECK_TIMEOUT_SECONDS: Hard limit for workspace typecheck
# Default/minimum: 3
ARC_TDD_TYPECHECK_TIMEOUT_SECONDS=3

# ARC_TDD_UNIT_TIMEOUT_SECONDS: Hard limit for one unit test command
# Default/minimum: 3
ARC_TDD_UNIT_TIMEOUT_SECONDS=3

# ARC_TDD_INTEGRATION_TIMEOUT_SECONDS: Hard limit for one integration test command
# Default/minimum: 3
ARC_TDD_INTEGRATION_TIMEOUT_SECONDS=3

# ARC_TDD_E2E_TIMEOUT_SECONDS: Hard limit for one Playwright command, including webServer startup
# Default/minimum: 300/3 seconds
ARC_TDD_E2E_TIMEOUT_SECONDS=300

# ============================================================
# Optional: Custom environment file path
# ============================================================
# ARC_ENV_FILE: Point to a different .env file
# Example: ARC_ENV_FILE=~/.arc/global.env
# ARC_ENV_FILE=
