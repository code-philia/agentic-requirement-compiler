        "owner_id": {
          "type": "string",
          "pattern": "^[CEHF]\\.[A-Za-z0-9_][A-Za-z0-9_.-]*$"
        },
        "direction": {
          "enum": [
            "INPUT",
            "OUTPUT"
          ]
        },
        "type": {
          "$ref": "#/$defs/type"
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "anyOf": [
            {
              "$ref": "#/$defs/literal"
            },
