{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARC React frontend design IR v1",
  "description": "Seven-entity design IR. Cross-reference and behavioral validity additionally require FIR001–FIR016 in metamodel.md.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "arc.frontend-ir/1.0"
    },
    "root_component_id": {
      "type": "string",
      "pattern": "^[C]\\.[A-Za-z0-9_][A-Za-z0-9_.-]*$"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      },
      "minItems": 1
    },
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/data"
      }
    },
    "properties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/property"
      }
    },
    "ui": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ui"
      },
      "minItems": 1
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "handlers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/handler"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    }
  },
  "required": [
    "schema_version",
    "root_component_id",
    "components",
    "data",
    "properties",
    "ui",
    "events",
    "handlers",
    "effects"
  ],
  "additionalProperties": false,
  "$defs": {
