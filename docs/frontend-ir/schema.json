                  "type",
                  "required"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "union"
            },
            "variants": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/type"
              },
              "minItems": 2,
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "variants"
          ],
          "additionalProperties": false
        }
      ]
    },
    "path": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "integer",
            "minimum": 0
