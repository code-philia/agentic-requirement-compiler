          "$ref": "#/$defs/literal"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "REF"
            },
            "ref_id": {
              "type": "string",
              "pattern": "^[DP]\\.[A-Za-z0-9_][A-Za-z0-9_.-]*$"
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          },
          "required": [
            "kind",
            "ref_id",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ITEM"
            },
            "ui_id": {
              "type": "string",
              "pattern": "^[U]\\.[A-Za-z0-9_][A-Za-z0-9_.-]*$"
