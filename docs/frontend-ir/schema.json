    "data": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[D]\\.[A-Za-z0-9_][A-Za-z0-9_.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "spec": {
          "type": "string",
          "minLength": 1
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
