  "events": [
    {
      "id": "E.QueryChanged",
      "name": "Query changed",
      "spec": "捕获输入框 change 交互，将 currentTarget.value 提取为 D.QueryChanged.value；不阻止默认行为，不停止传播。",
      "requirement_ids": [
        "REQ.SEARCH"
      ],
      "component_id": "C.Search",
      "kind": "UI",
      "ui_id": "U.Query",
      "event_name": "change",
      "handler_id": "H.UpdateQuery",
      "arguments": [
        {
          "parameter_id": "D.UpdateQuery.value",
          "value": {
            "kind": "REF",
            "ref_id": "D.QueryChanged.value",
            "path": []
          }
        }
      ]
    }
  ],
  "handlers": [
    {
      "id": "H.UpdateQuery",
      "name": "Update query",
      "spec": "收到输入后，将 D.UpdateQuery.value 原样写入 P.Search.query；无异步等待，不发出业务事件。搜索由响应式 Effect 跟随 query 变化执行。",
      "requirement_ids": [
        "REQ.SEARCH"
      ],
      "component_id": "C.Search",
      "reads": [
        "D.UpdateQuery.value"
      ],
      "writes": [
        "P.Search.query"
      ],
      "invokes": [],
      "emits": []
    }
  ],
  "effects": [
    {
      "id": "F.SearchRequest",
      "name": "Search request",
      "spec": "挂载后及关键词变化后执行。输入 query 是空字符串时，不请求接口，将 results=[]、loading=false、error=null。否则先将 results=[]、loading=true、error=null，再调用 API.SearchItems，传入 query。成功时将 D.SearchRequest.items 写入 results；失败时将 results=[]，error 写为适合用户阅读的错误文本。仅当前有效执行可在成功或失败结束时写入 loading=false。旧执行的成功、失败和最终状态写入均忽略；取消不展示为错误。",
      "requirement_ids": [
        "REQ.SEARCH"
      ],
      "component_id": "C.Search",
      "kind": "REQUEST",
      "activation": "REACTIVE",
      "dependencies": [
        "P.Search.query"
      ],
      "arguments": [
        {
          "parameter_id": "D.SearchRequest.query",
          "value": {
            "kind": "REF",
            "ref_id": "P.Search.query",
            "path": []
          }
        }
      ],
      "reads": [],
      "writes": [
        "P.Search.results",
        "P.Search.loading",
        "P.Search.error"
      ],
      "target": "API.SearchItems",
      "async_policy": "LATEST_WINS",
      "cleanup": "依赖变化或卸载时，使本次执行失效并取消未完成请求；接口传输层支持取消。取消后的完成、失败与最终状态更新均不得写入状态。"
    }
  ]
