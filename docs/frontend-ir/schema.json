      "required": [
        "id",
        "name",
        "spec",
        "requirement_ids",
        "owner_id",
        "direction",
        "type",
        "required",
        "default"
      ],
      "additionalProperties": false
    },
    "property": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[P]\\.[A-Za-z0-9_][A-Za-z0-9_.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "spec": {
          "type": "string",
          "minLength": 1
